# Supabase — `supabase start` los imprime para el entorno local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<anon key>
# Clave de servicio: la usan las rutas de /api/github para escribir saltándose
# el RLS (la pertenencia se comprueba a mano en server/utils/gh/guard.ts).
SUPABASE_SERVICE_KEY=<service role key>

# Servicio de compilación (M4): local con docker run, o la URL de Cloud Run
NUXT_PUBLIC_COMPILER_URL=http://localhost:8080

# GitHub App (sincronizar un proyecto con una carpeta del repo del curso).
# Sin esto, el diálogo de GitHub dice que falta configurarla y no hace nada más.
# Ver docs/github-app.md: los campos de la App, y por qué Setup URL y Callback
# URL no son lo mismo.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# En una línea, con los saltos escapados como \n
GITHUB_APP_PRIVATE_KEY=
# «Iniciar sesión con GitHub»: sin esto se puede sincronizar, pero no se sabe de
# quién es cada instalación, y cada quien tendría que instalar la App por su
# cuenta para verla.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
